{
  "about": "Test vectors for the three checks of a mod's manifest (docs/port/MODS.md, section 3). Each check's tests load this file and assert these verdicts. Read README.md beside it before changing a case.",
  "validators": {
    "launcher": "launcher/core/src/plugins.rs: serde reads the file into Manifest, then Manifest::validate",
    "sdk": "sdk/tools/package_mod.py: check_manifest, without the files (root=None) and with the SDK's hook tables",
    "port": "port/game/common/mod_manifest.cpp: parse_manifest"
  },
  "ids": [
    {"id": "lock-strafe", "valid": true},
    {"id": "a1-b2", "valid": true},
    {"id": "7", "valid": true},
