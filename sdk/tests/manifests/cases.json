    {"name": "a native mod with every field", "valid": true,
     "manifest": {
       "format": 2,
       "id": "lock-strafe",
       "name": "Lock-strafe",
       "version": "1.2.0",
       "author": "OpenRAC contributors",
       "description": "Strafe as in the later games.",
       "license": "GPL-3.0-or-later",
       "homepage": "https://github.com/OpenRAC/rac1-mods",
       "api": "1.2",
       "games": {"rac1": ["pal", "ntsc"]},
       "plugin": {"macos-arm64": "lib/macos-arm64/lock_strafe.dylib", "linux-x86_64": "lib/linux-x86_64/lock_strafe.so", "windows-x86_64": "lib/windows-x86_64/lock_strafe.dll"},
       "hooks": ["Pad_ProcessReport"],
       "settings": [
         {"key": "mode", "name": "Mode", "type": "choice", "default": "lock", "choices": [{"value": "lock", "name": "Lock"}, {"value": "hold", "name": "Hold"}], "description": "How."},
         {"key": "trace", "name": "Trace", "type": "bool", "default": false},
         {"key": "every", "name": "Every", "type": "int", "default": 60, "min": 1, "max": 600},
         {"key": "scale", "name": "Scale", "type": "float", "default": 1.0, "min": 0.5, "max": 2, "step": 0.1},
         {"key": "label", "name": "Label", "type": "string", "default": "hi", "max_length": 8},
         {"key": "jump", "name": "Jump", "type": "keybind", "default": "Space,KeyA", "group": "play"},
         {"key": "back", "name": "Back", "type": "keybind", "default": "KeyB", "binds": 1, "group": "menu"}
       ],
       "presets": [
         {"id": "hard", "name": "Hard", "values": {"every": 600, "scale": 2, "mode": "hold", "trace": true, "label": "abcdefgh", "jump": "KeyB"}}
       ],
       "requires": [
         {"id": "base-lib", "version": ">=1.2.0"},
         {"id": "other-lib", "version": "=2.0.0"},
         {"id": "any-lib"}
       ],
       "conflicts": [{"id": "other-strafe", "reason": "both take L2 and R2"}],
       "load": {"after": ["camera-tweaks"], "before": []}
     }},
