+#ifdef __SWITCH__
+namespace {
+// Switch has no shell to set test switches in. KEY=VALUE lines of sdmc:/switch/openrac/env.txt
+// (blank lines and # comments skipped) go into the environment before anything reads it, so
+// OPENRAC_RENDER_OPT_OFF, OPENRAC_GPU_MATERIALS_OFF, OPENRAC_FRAME_COST and the rest can be
+// tried without a rebuild. What was applied is written to env-applied.log beside it.
+void load_switch_env() {
+    std::FILE* in = std::fopen("sdmc:/switch/openrac/env.txt", "r");
+    if (in == nullptr) {
+        std::remove("sdmc:/switch/openrac/env-applied.log");
+        return;
+    }
+    std::FILE* report = std::fopen("sdmc:/switch/openrac/env-applied.log", "w");
+    char buffer[1024];
+    const auto trim = [](std::string text) {
+        const auto first = text.find_first_not_of(" \t\r\n");
+        if (first == std::string::npos) return std::string();
+        const auto last = text.find_last_not_of(" \t\r\n");
+        return text.substr(first, last - first + 1);
+    };
+    while (std::fgets(buffer, sizeof buffer, in) != nullptr) {
+        const std::string line = trim(buffer);
+        if (line.empty() || line[0] == '#') continue;
+        const auto eq = line.find('=');
+        if (eq == std::string::npos) continue;
+        const std::string key = trim(line.substr(0, eq));
+        const std::string value = trim(line.substr(eq + 1));
+        if (key.empty()) continue;
+        setenv(key.c_str(), value.c_str(), 1);
+        if (report != nullptr) std::fprintf(report, "%s=%s\n", key.c_str(), value.c_str());
+    }
+    std::fclose(in);
+    if (report != nullptr) std::fclose(report);
+}
+}  // namespace
+#endif
+
 int main(int argc, char** argv) {
+#ifdef __SWITCH__
+    load_switch_env();  // first: the environment is read once, at its first use
+#endif
 #ifdef __SWITCH__
     bool from_switch_launcher = false;
 #endif
