# The port's C++ checks: the rules of docs/CODING_CONVENTIONS.md that clang-tidy can see,
# mostly naming, ownership and the shape of control flow. Run it on the C++ files you touch:
#
#   run-clang-tidy -p build/release -quiet 'port/renderer/gl\.cpp'
#   clang-tidy -p build/release renderer/gl.cpp
#
# It reads the compile commands of a configured build (CMAKE_EXPORT_COMPILE_COMMANDS is on).
# Existing code has findings; new code and the lines you change have none. CI does not run it:
# it needs a full build. tools/conventions/check_conventions.py is what CI runs.
---
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  cppcoreguidelines-avoid-goto,
  cppcoreguidelines-no-malloc,
  cppcoreguidelines-owning-memory,
  cppcoreguidelines-pro-type-cstyle-cast,
  cppcoreguidelines-special-member-functions,
  cppcoreguidelines-virtual-class-destructor,
  google-explicit-constructor,
  google-global-names-in-headers,
  misc-definitions-in-headers,
  misc-unused-using-decls,
  misc-use-anonymous-namespace,
  modernize-make-unique,
  modernize-use-equals-default,
  modernize-use-equals-delete,
  modernize-use-nullptr,
  modernize-use-override,
  modernize-use-using,
  performance-*,
  -performance-enum-size,
  readability-avoid-nested-conditional-operator,
  readability-braces-around-statements,
  readability-else-after-return,
  readability-function-size,
  readability-identifier-naming,
  readability-misleading-indentation,
  readability-static-definition-in-anonymous-namespace

# Only the port's own headers; a game's hand C and build trees are not the port's C++.
HeaderFilterRegex: '.*/port/.*'
ExcludeHeaderFilterRegex: '.*/(hand|build|_deps)/.*'
FormatStyle: file

CheckOptions:
  # A special member defaulted or deleted on its own is fine: the rule of zero is the aim.
  cppcoreguidelines-special-member-functions.AllowSoleDefaultDtor: true
  cppcoreguidelines-special-member-functions.AllowMissingMoveFunctionsWhenCopyIsDeleted: true

  # Function size (CODING_CONVENTIONS.md, "Functions"): 60 lines, 5 parameters, 3 nested levels.
  readability-function-size.LineThreshold: 60
  readability-function-size.ParameterThreshold: 5
  readability-function-size.NestingThreshold: 4

  # Naming (CODING_CONVENTIONS.md, "Naming").
  readability-identifier-naming.NamespaceCase: lower_case
  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.StructCase: CamelCase
  readability-identifier-naming.UnionCase: CamelCase
  readability-identifier-naming.EnumCase: CamelCase
  readability-identifier-naming.TypeAliasCase: CamelCase
  readability-identifier-naming.TypedefCase: CamelCase
  readability-identifier-naming.ConceptCase: CamelCase
  readability-identifier-naming.TemplateParameterCase: CamelCase
  readability-identifier-naming.ValueTemplateParameterCase: CamelCase
  readability-identifier-naming.FunctionCase: lower_case
  readability-identifier-naming.MethodCase: lower_case
  readability-identifier-naming.ParameterCase: lower_case
  readability-identifier-naming.LocalVariableCase: lower_case
  readability-identifier-naming.VariableCase: lower_case
  readability-identifier-naming.PublicMemberCase: lower_case
  readability-identifier-naming.PrivateMemberCase: lower_case
  readability-identifier-naming.PrivateMemberPrefix: m_
  readability-identifier-naming.ProtectedMemberCase: lower_case
  readability-identifier-naming.ProtectedMemberPrefix: m_
  readability-identifier-naming.ConstexprVariableCase: CamelCase
  readability-identifier-naming.ConstexprVariablePrefix: k
  readability-identifier-naming.GlobalConstantCase: CamelCase
  readability-identifier-naming.GlobalConstantPrefix: k
  readability-identifier-naming.ClassConstantCase: CamelCase
  readability-identifier-naming.ClassConstantPrefix: k
  # A function's `static const` is worked out at run time: a variable, not a constant.
  readability-identifier-naming.StaticConstantCase: lower_case
  readability-identifier-naming.EnumConstantCase: CamelCase
  readability-identifier-naming.EnumConstantPrefix: k
  readability-identifier-naming.ScopedEnumConstantCase: CamelCase
  readability-identifier-naming.MacroDefinitionCase: UPPER_CASE
  # A name taken from an outside API or format keeps its spelling: the C contracts'
  # openrac_*, OpenGL's GL_* and gl*, the console's formats and registers (PSMCT32, a register's
  # context suffix as in kTex0_1) and the byte aliases.
  readability-identifier-naming.FunctionIgnoredRegexp: '^(openrac_.*|main)$'
  readability-identifier-naming.ConstexprVariableIgnoredRegexp: '^GL_[A-Z0-9_]+$'
  readability-identifier-naming.VariableIgnoredRegexp: '^gl[A-Z][A-Za-z0-9]*$'
  readability-identifier-naming.EnumConstantIgnoredRegexp: '^([A-Z][A-Z0-9_]*|k[A-Z][A-Za-z0-9]*_[0-9]+)$'
  readability-identifier-naming.TypeAliasIgnoredRegexp: '^([us](8|16|32|64)|f32|GL[a-z]+)$'
  readability-identifier-naming.MacroDefinitionIgnoredRegexp: '^CHECK$'
