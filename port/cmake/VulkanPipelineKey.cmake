include_guard(GLOBAL)

# Backport of upstream 06379ee7's shader-aware cache key. Search source trees
# explicitly: this checkout has several build-* directories with fetched SDKs.
# Including those would make keys depend on generated files and other builds.
function(openrac_vulkan_pipeline_key root key_out dependencies_out)
  set(patterns)
  foreach(tree renderer enhanced scene game/common platform viewer)
    foreach(extension vert frag comp glsl cpp h inc)
      list(APPEND patterns "${root}/${tree}/*.${extension}")
    endforeach()
  endforeach()
  if(CMAKE_SCRIPT_MODE_FILE)
    file(GLOB_RECURSE candidates LIST_DIRECTORIES false RELATIVE "${root}" ${patterns})
  else()
    file(GLOB_RECURSE candidates CONFIGURE_DEPENDS LIST_DIRECTORIES false RELATIVE "${root}" ${patterns})
  endif()
  list(FILTER candidates EXCLUDE REGEX "(^|/)(tests|build[^/]*|generated)/")
  list(FILTER candidates EXCLUDE REGEX "^renderer/deko3d/")
  list(SORT candidates)
  list(TRANSFORM candidates PREPEND "${root}/")
  set(sources ${ARGN})
  foreach(candidate IN LISTS candidates)
    if(candidate IN_LIST sources)
      continue()
    endif()
    # Included GLSL snippets need hashing too, even without their own #version.
    if(candidate MATCHES "\\.(vert|frag|comp|glsl)$")
      list(APPEND sources "${candidate}")
    else()
      file(STRINGS "${candidate}" version REGEX "#version [0-9]" LIMIT_COUNT 1)
      if(version)
        list(APPEND sources "${candidate}")
      endif()
    endif()
  endforeach()
  list(REMOVE_DUPLICATES sources)
  list(SORT sources)
  set(contents "")
  foreach(source IN LISTS sources)
    file(SHA256 "${source}" digest)
    file(RELATIVE_PATH relative "${root}" "${source}")
    string(APPEND contents "${relative}:${digest}\n")
  endforeach()
  string(SHA256 key "${contents}")
  string(SUBSTRING "${key}" 0 12 key)
  set(${key_out} "${key}" PARENT_SCOPE)
  # Watch even a C++ source without GLSL: adding an inline shader must refresh
  # the key, as must creating a new shader (the CONFIGURE_DEPENDS glob above).
  set(${dependencies_out} ${sources} ${candidates} PARENT_SCOPE)
endfunction()
