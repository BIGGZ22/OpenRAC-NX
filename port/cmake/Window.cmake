include_guard(GLOBAL)
include(Dependencies)

# GLSL sources become C++ string constants in <name>_shaders.h / .cpp under
# the build directory: namespace <namespace>::shaders, one constant per file,
# named after it (direct.frag -> direct_frag). Shaders are part of the
# program, so a build never depends on files beside the executable. Editing a
# shader re-runs CMake's configure step, which rewrites only what changed.
function(openrac_embed_shaders target name namespace)
  set(dir "${CMAKE_CURRENT_BINARY_DIR}/generated")
  set(declarations "")
  set(definitions "")
  set(registrations "")
  foreach(file IN LISTS ARGN)
    get_filename_component(base "${file}" NAME)
    string(REPLACE "." "_" symbol "${base}")
    file(READ "${file}" text)
    string(APPEND declarations "extern const char *const ${symbol};\n")
    string(APPEND definitions "const char *const ${symbol} = R\"glsl(${text})glsl\";\n")
    # For the debug tools (common/stats.h): the file each built-in source came from, under port/.
    file(RELATIVE_PATH relative "${PROJECT_SOURCE_DIR}" "${file}")
    string(APPEND registrations "\n    + openrac::stats::embedded_shader(\"${relative}\", ${namespace}::shaders::${symbol})")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${file}")
  endforeach()
  set(banner "// Generated by port/cmake/Window.cmake from GLSL sources; do not edit.\n")
  file(CONFIGURE OUTPUT "${dir}/${name}_shaders.h"
    CONTENT "${banner}#pragma once\n\nnamespace ${namespace}::shaders {\n${declarations}}\n"
    @ONLY)
  file(CONFIGURE OUTPUT "${dir}/${name}_shaders.cpp"
    CONTENT "${banner}#include \"${name}_shaders.h\"\n\n#include \"common/stats.h\"\n\nnamespace ${namespace}::shaders {\n${definitions}}\n\nnamespace {\n[[maybe_unused]] const int registered = openrac::stats::embedded_shader_root(\"${PROJECT_SOURCE_DIR}\")${registrations};\n}\n"
    @ONLY)
  target_sources(${target} PRIVATE "${dir}/${name}_shaders.cpp")
  target_include_directories(${target} PRIVATE "${dir}")
endfunction()

# ---- platform ----
add_library(openrac_platform STATIC
  platform/audio.cpp
  platform/clock.cpp
  platform/input.cpp
  platform/pad.cpp
  platform/pump.cpp
  platform/window.cpp
)
target_link_libraries(openrac_platform PUBLIC openrac_common openrac_sdl3)
openrac_warnings(openrac_platform)
# macOS: the menu bar's name and menus (platform/macos_app.mm).
if(APPLE)
  target_sources(openrac_platform PRIVATE platform/macos_app.mm)
  target_link_libraries(openrac_platform PRIVATE "-framework Cocoa")
endif()

# ---- renderer ----
add_library(openrac_renderer STATIC
  renderer/direct.cpp
  renderer/effects.cpp
  renderer/framebuffer.cpp
  renderer/gl.cpp
  renderer/gl_stats.cpp
  renderer/renderer.cpp
  renderer/shader.cpp
  renderer/subsystems.cpp
  renderer/texture.cpp
  renderer/texture_pool.cpp
)
openrac_embed_shaders(openrac_renderer renderer openrac::renderer
  "${CMAKE_CURRENT_SOURCE_DIR}/renderer/shaders/direct.vert"
  "${CMAKE_CURRENT_SOURCE_DIR}/renderer/shaders/direct.frag"
  "${CMAKE_CURRENT_SOURCE_DIR}/renderer/shaders/effect.vert"
)
target_link_libraries(openrac_renderer PUBLIC openrac_common)
openrac_warnings(openrac_renderer)

# ---- the world's renderers: renderer/world, shaders in renderer/shaders/world ----
file(GLOB world_sources CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/renderer/world/*.cpp")
openrac_part_enabled(renderer_world enabled)
if(world_sources AND enabled)
  add_library(openrac_renderer_world STATIC ${world_sources})
  file(GLOB world_shaders CONFIGURE_DEPENDS
    "${CMAKE_CURRENT_SOURCE_DIR}/renderer/shaders/world/*.vert"
    "${CMAKE_CURRENT_SOURCE_DIR}/renderer/shaders/world/*.frag"
    "${CMAKE_CURRENT_SOURCE_DIR}/renderer/shaders/world/*.glsl")
  list(SORT world_shaders)
  openrac_embed_shaders(openrac_renderer_world world openrac::renderer::world ${world_shaders})
  target_link_libraries(openrac_renderer_world PUBLIC openrac_renderer openrac_assets_core)
  openrac_warnings(openrac_renderer_world)
  openrac_add_module_tests(world openrac_renderer_world openrac_platform)
endif()

