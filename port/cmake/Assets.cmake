#
# The libraries every program shares that need no window:
#
#   openrac_assets   the games' data formats, read from the player's disc
#                    (no GL, no SDL): assets/
#   openrac_media    the movies (PSS, MPEG-2 video) and ADPCM sound: media/
#   openrac_audio    the sound engine the games' sound library drives: audio/
#   openrac-extractor  sets a game up from the player's disc: extract/
#
# Each library takes every .cpp of its directory; each tests/<module>/*.cpp is
# a test program of its own (tests/<module>/foo.cpp -> <module>_foo_test;
# the module of assets/disc is \"disc\").
# A test that needs the player's disc or extracted data reads its path from
# the environment (OPENRAC_DISC_<ID>, OPENRAC_DATA_<ID>; ID as RAC1_NTSC) and
# returns 77, reported as skipped, without it.
#
# Included from port/CMakeLists.txt.

include_guard(GLOBAL)

# The table of game versions (assets/version.h), from games/*/game.json.
function(openrac_write_versions out)
  get_filename_component(root "${CMAKE_CURRENT_SOURCE_DIR}/.." ABSOLUTE)
  file(GLOB game_files "${root}/games/*/game.json")
  list(SORT game_files)
  set(rows "")
  foreach(game_file IN LISTS game_files)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${game_file}")
    file(READ "${game_file}" json)
    string(JSON game GET "${json}" id)
    string(JSON title GET "${json}" title)
    string(JSON count LENGTH "${json}" versions)
    math(EXPR last "${count} - 1")
    foreach(i RANGE ${last})
      string(JSON ver MEMBER "${json}" versions ${i})
      string(JSON v GET "${json}" versions ${ver})
      string(JSON serial GET "${v}" serial)
      string(JSON video GET "${v}" disc video)
      string(JSON volume GET "${v}" disc volume)
      string(JSON disc_version GET "${v}" disc version)
      string(JSON disc_size GET "${v}" disc size)
      string(JSON disc_sha1 GET "${v}" disc sha1)
      string(JSON boot_size GET "${v}" boot size)
      string(JSON boot_sha1 GET "${v}" boot sha1)
      string(TOLOWER "${boot_sha1}" boot_sha1)
      string(TOLOWER "${disc_sha1}" disc_sha1)
      string(JSON vtitle ERROR_VARIABLE no_title GET "${json}" titles ${ver})
      if(no_title)
        set(vtitle "${title}")
      endif()
      string(REPLACE "\"" "\\\"" vtitle "${vtitle}")
      string(SUBSTRING "${game}" 3 1 number)
      if(ver STREQUAL "pal")
        set(region "Region::Pal")
        set(rate 50)
      elseif(ver STREQUAL "ntsc")
        set(region "Region::NtscU")
        set(rate 60)
      else()
        set(region "Region::NtscJ")
        set(rate 60)
      endif()
      if(NOT video STREQUAL "PAL" AND rate EQUAL 50)
        message(WARNING "${game_file}: ${ver} is not PAL video")
      endif()
      string(APPEND rows
        "    {\"${game}-${ver}\", \"${game}/${ver}\", Game::Rac${number}, ${region}, \"${vtitle}\", "
        "\"${serial}\", \"${volume}\", \"${disc_version}\", ${disc_size}ull, \"${disc_sha1}\", "
        "${boot_size}ull, \"${boot_sha1}\", ${rate}},\n")
    endforeach()
  endforeach()
  file(CONFIGURE OUTPUT "${out}"
    CONTENT "// Generated by port/cmake/Assets.cmake from games/*/game.json; do not edit.\n${rows}"
    @ONLY)
endfunction()

# A library made of every .cpp in a directory of port/.
function(openrac_add_module target dir)
  file(GLOB sources CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/${dir}/*.cpp")
  if(NOT sources)
    return()  # a module not written yet
  endif()
  add_library(${target} STATIC ${sources})
  target_link_libraries(${target} PUBLIC openrac_common ${ARGN})
  openrac_warnings(${target})
endfunction()

# One test program per tests/<dir>/*.cpp, linked to `libs`.
function(openrac_add_module_tests dir)
  file(GLOB tests CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/tests/${dir}/*.cpp")
  foreach(lib IN LISTS ARGN)
    if(NOT TARGET ${lib})
      return()
    endif()
  endforeach()
  foreach(test IN LISTS tests)
    get_filename_component(name "${test}" NAME_WE)
    set(target "${dir}_${name}_test")
    add_executable(${target} "${test}")
    target_link_libraries(${target} PRIVATE ${ARGN})
    openrac_warnings(${target})
    add_test(NAME "${dir}_${name}" COMMAND ${target})
    set_tests_properties("${dir}_${name}" PROPERTIES SKIP_RETURN_CODE 77)
  endforeach()
endfunction()

set(OPENRAC_GENERATED "${CMAKE_CURRENT_BINARY_DIR}/generated")
openrac_write_versions("${OPENRAC_GENERATED}/assets_versions.inc")

# openrac_assets is its parts, each a library of its own so each builds and
# is tested alone:
#   assets/           the byte reader, the table of versions
#   assets/disc/      the disc: ISO 9660, the table of contents, WAD
#                     compression, the level files, overlays, saves, text
#   assets/geometry/  what the renderer draws: textures, terrain (tfrag),
#                     ties, shrubs, the sky, moby classes and animation,
#                     baked lighting
#   assets/world/     what the game reads about a level: collision,
#                     occlusion, cameras, the gameplay file, water, fonts, HUD
#   assets/sound/     sound banks, VAG, PSS movies (containers)
openrac_add_module(openrac_assets_core assets)
target_include_directories(openrac_assets_core PRIVATE "${OPENRAC_GENERATED}")
add_library(openrac_assets INTERFACE)
target_link_libraries(openrac_assets INTERFACE openrac_assets_core)
openrac_add_module_tests(assets openrac_assets_core)
# The ReRAC conversion is finished part by part (WIP.md): a part builds by
# default once it is reviewed and tested and listed here; the others only
# with -DOPENRAC_PORT_WIP=ON.
option(OPENRAC_PORT_WIP "Build the unfinished parts of the ReRAC conversion (WIP.md)" OFF)
set(OPENRAC_PORT_READY disc extract geometry world sound media audio renderer_world)
function(openrac_part_enabled part out)
  if(OPENRAC_PORT_WIP OR part IN_LIST OPENRAC_PORT_READY)
    set(${out} ON PARENT_SCOPE)
  else()
    set(${out} OFF PARENT_SCOPE)
  endif()
endfunction()

foreach(part disc geometry world sound)
  openrac_part_enabled(${part} enabled)
  if(NOT enabled)
    continue()
  endif()
  openrac_add_module(openrac_assets_${part} assets/${part} openrac_assets_core)
  if(TARGET openrac_assets_${part})
    target_link_libraries(openrac_assets INTERFACE openrac_assets_${part})
    # tests/world is the world renderers'; the world data's are tests/assets_world
    if(part STREQUAL "world")
      openrac_add_module_tests(assets_world openrac_assets_world)
    else()
      openrac_add_module_tests(${part} openrac_assets_${part})
    endif()
  endif()
endforeach()

# Gadget classes are WAD streams inside the core data; fonts are found in
# the level program.
foreach(part geometry world)
  if(TARGET openrac_assets_${part} AND TARGET openrac_assets_disc)
    target_link_libraries(openrac_assets_${part} PUBLIC openrac_assets_disc)
  endif()
endforeach()

openrac_part_enabled(media enabled)
if(enabled)
  openrac_add_module(openrac_media media openrac_assets)
  openrac_add_module_tests(media openrac_media)
endif()

openrac_part_enabled(audio enabled)
if(enabled AND TARGET openrac_media)
  openrac_add_module(openrac_audio audio openrac_assets openrac_media)
  openrac_add_module_tests(audio openrac_audio)
endif()

# The extractor: every extract/*.cpp but main.cpp is openrac_extract (tested),
# main.cpp is openrac-extractor.
file(GLOB extractor_sources CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/extract/*.cpp")
list(FILTER extractor_sources EXCLUDE REGEX "/main\\.cpp$")
openrac_part_enabled(extract enabled)
if(extractor_sources AND enabled)
  add_library(openrac_extract STATIC ${extractor_sources})
  target_link_libraries(openrac_extract PUBLIC openrac_assets)
  openrac_warnings(openrac_extract)
  if(EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/extract/main.cpp")
    add_executable(openrac-extractor extract/main.cpp)
    target_link_libraries(openrac-extractor PRIVATE openrac_extract)
    openrac_warnings(openrac-extractor)
  endif()
  openrac_add_module_tests(extract openrac_extract)
endif()
