#
# common/build_info.h's answers: OpenRAC's version (the launcher's, from tauri.conf.json) and the
# checkout's commit, written to OUT at every build and replaced only when they changed, so a build
# without a new commit compiles nothing again. Run as a script:
#
#   cmake -DREPO=<checkout> -DOUT=<file.cpp> -P BuildInfo.cmake

set(version "unknown")
set(conf "${REPO}/launcher/src-tauri/tauri.conf.json")
if(EXISTS "${conf}")
  file(READ "${conf}" json)
  string(JSON found ERROR_VARIABLE no_version GET "${json}" version)
  if(NOT no_version)
    set(version "${found}")
  endif()
endif()

set(commit "unknown")
find_program(GIT git)
if(GIT)
  execute_process(COMMAND "${GIT}" -C "${REPO}" rev-parse --short=8 HEAD
                  OUTPUT_VARIABLE head RESULT_VARIABLE failed OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  if(NOT failed AND head)
    set(commit "${head}")
    # Changes to the port's own files only: the games' trees change all the time beside it.
    execute_process(COMMAND "${GIT}" -C "${REPO}" status --porcelain --untracked-files=no -- port
                    OUTPUT_VARIABLE changes ERROR_QUIET)
    if(changes)
      set(commit "${commit}-dirty")
    endif()
  endif()
endif()

set(text "// Generated by cmake/BuildInfo.cmake at each build.
#include \"common/build_info.h\"

namespace openrac::build_info {
const char* version() { return \"${version}\"; }
const char* commit() { return \"${commit}\"; }
}  // namespace openrac::build_info
")
if(EXISTS "${OUT}")
  file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL text)
  file(WRITE "${OUT}" "${text}")
endif()
