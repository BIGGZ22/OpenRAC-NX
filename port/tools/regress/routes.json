{
  "comment": "Gameplay routes for port/tools/regress (docs/port/REGRESSION.md). Each level starts directly (OPENRAC_DIRECT with --level N), presses Cross through the boot screens, holds Start through scenes and the flight until control, then plays its sequence. Step frames count from control, so every version plays the same moments. A level may name another sequence, change length or max_frames, and override any of that per game under its game's id.",
  "defaults": {
    "boot": [{"at": 100, "buttons": "cross", "hold": 5}],
    "skip": {"every": 30, "buttons": "start", "hold": 5},
    "sequence": "standard",
    "length": 660,
    "max_frames": 9000,
    "timeout": 240
  },
  "sequences": {
    "standard": [
      {"at": 30, "hold": 120, "left": [128, 0], "what": "walk forward"},
      {"at": 160, "hold": 150, "right": [255, 128], "what": "turn the camera round"},
      {"at": 320, "hold": 5, "buttons": "cross", "what": "jump"},
      {"at": 360, "hold": 5, "buttons": "square", "what": "swing the wrench"},
      {"at": 400, "hold": 90, "left": [0, 128], "what": "walk left"},
      {"at": 490, "hold": 100, "left": [128, 0], "what": "walk forward"},
      {"at": 530, "hold": 5, "buttons": "cross", "left": [128, 0], "what": "jump while walking"},
      {"at": 600, "hold": 5, "buttons": "square", "what": "swing the wrench"}
    ]
  },
  "levels": {
    "0": {"name": "Veldin", "versions": [
      {"fields": ["mb"], "from": 0, "why": "a bolt more or less: the random sequence parts on the level's 20th frame, where PAL's run draws numbers in level 0's code at US 0x20A9E8 (called from 0x2070D0) and US's does not (RAC1_NTSC_HINTS.md 7)"}
    ]},
    "1": {"name": "Novalis", "versions": [
      {"fields": ["mb"], "from": 0, "why": "the scene before control ends two ticks apart (the route's Start presses fall on window frames, and the versions reach the level at other frames), so the level's mobys run that much out of step with the hero (RAC1_NTSC_HINTS.md 7)"}
    ]},
    "2": {"name": "Aridia"},
