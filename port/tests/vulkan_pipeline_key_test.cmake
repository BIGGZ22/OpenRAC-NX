cmake_minimum_required(VERSION 3.24)
# Pure source-file checks: this script does not configure or build any target.
if(NOT DEFINED TEST_ROOT OR EXISTS "${TEST_ROOT}")
  message(FATAL_ERROR "Pass a fresh TEST_ROOT inside the workspace")
endif()
file(MAKE_DIRECTORY "${TEST_ROOT}/renderer/shaders" "${TEST_ROOT}/platform"
  "${TEST_ROOT}/build-other/renderer" "${TEST_ROOT}/enhanced/tests")
get_filename_component(root "${TEST_ROOT}" ABSOLUTE)
include("${CMAKE_CURRENT_LIST_DIR}/../cmake/VulkanPipelineKey.cmake")
file(WRITE "${root}/renderer/backend.cpp" "backend implementation\n")
file(WRITE "${root}/renderer/shaders/picture.frag" "#version 450\nvoid main() {}\n")
file(WRITE "${root}/renderer/shaders/shared.glsl" "vec3 shade() { return vec3(1); }\n")
file(WRITE "${root}/platform/ui.cpp" "no shader yet\n")
openrac_vulkan_pipeline_key("${root}" original deps "${root}/renderer/backend.cpp")
file(APPEND "${root}/renderer/shaders/picture.frag" "// changed shader\n")
openrac_vulkan_pipeline_key("${root}" shader_changed deps "${root}/renderer/backend.cpp")
if(original STREQUAL shader_changed)
  message(FATAL_ERROR "Shader changes did not invalidate the pipeline key")
endif()
file(APPEND "${root}/renderer/shaders/shared.glsl" "// changed snippet\n")
openrac_vulkan_pipeline_key("${root}" snippet_changed deps "${root}/renderer/backend.cpp")
if(shader_changed STREQUAL snippet_changed)
  message(FATAL_ERROR "Included GLSL snippet did not invalidate the pipeline key")
endif()
file(WRITE "${root}/platform/ui.cpp" "const char* shader = \"#version 450\\nvoid main(){}\";\n")
openrac_vulkan_pipeline_key("${root}" inline_changed deps "${root}/renderer/backend.cpp")
if(snippet_changed STREQUAL inline_changed)
  message(FATAL_ERROR "Inline GLSL did not invalidate the pipeline key")
endif()
file(WRITE "${root}/build-other/renderer/foreign.cpp" "#version 450\n")
file(MAKE_DIRECTORY "${root}/renderer/build-other")
file(WRITE "${root}/renderer/build-other/foreign.frag" "#version 450\n")
file(MAKE_DIRECTORY "${root}/renderer/deko3d/shaders")
file(WRITE "${root}/renderer/deko3d/shaders/probe.frag" "#version 460\n")
file(WRITE "${root}/enhanced/tests/test.cpp" "#version 450\n")
file(WRITE "${root}/platform/plain.cpp" "unrelated code\n")
openrac_vulkan_pipeline_key("${root}" ignored deps "${root}/renderer/backend.cpp")
if(NOT ignored STREQUAL inline_changed)
  message(FATAL_ERROR "Unrelated code, test or another build contaminated the pipeline key")
endif()
file(APPEND "${root}/renderer/backend.cpp" "changed backend\n")
openrac_vulkan_pipeline_key("${root}" backend_changed deps "${root}/renderer/backend.cpp")
if(backend_changed STREQUAL ignored)
  message(FATAL_ERROR "Backend code did not invalidate the pipeline key")
endif()
message(STATUS "PASS: shader, snippet, inline and backend changes invalidate caches; other builds and tests are excluded")
