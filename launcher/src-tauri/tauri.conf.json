{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenRAC Launcher",
  "version": "0.5.0",
  "identifier": "dev.openrac.launcher",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "enableGTKAppId": true,
    "windows": [
      {
        "label": "main",
        "title": "OpenRAC Launcher",
        "width": 1200,
        "height": 780,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "backgroundColor": "#181820"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost https://openrac.dev https://bytematch.dev https://api.github.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/openrac": "openrac"
    }
  }
}
