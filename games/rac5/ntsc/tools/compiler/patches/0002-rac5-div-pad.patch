+/* RAC5: single-precision division family?  rsqrt.s is (div:SF (sqrt:SF ...)),
+   so DIV/SQRT on an SFmode destination covers div.s, sqrt.s and rsqrt.s.  */
+static int
+rac5_div_family_p (insn)
+     rtx insn;
+{
+  rtx pattern, src;
+
+  if (GET_CODE (insn) != INSN)
+    return 0;
+  pattern = PATTERN (insn);
+  if (GET_CODE (pattern) != SET)
+    return 0;
+  if (GET_MODE (SET_DEST (pattern)) != SFmode)
+    return 0;
+  src = SET_SRC (pattern);
+  return GET_CODE (src) == DIV || GET_CODE (src) == SQRT;
+}
+
+/* RAC5: measured retail floor.  Every single-precision division is preceded by
+   two nops, and the retail never leaves one in a branch delay slot.  A
+   division sitting in an *unconditional* jump/call delay slot is moved before
+   the jump (the slot always executes, so this preserves the order) and the
+   slot is filled with a nop; a conditional-branch slot is left alone.  */
+void
+mips_r5900_pad_divisions (first)
+     rtx first;
+{
+  rtx insn;
+
+  for (insn = first; insn; )
+    {
+      rtx next = NEXT_INSN (insn);
+
+      if (rac5_div_family_p (insn))
+        {
+          rtx prev = prev_real_insn (insn);
+          int pad = 1;
+
+          if (prev != 0
+              && (GET_CODE (prev) == JUMP_INSN || GET_CODE (prev) == CALL_INSN))
+            {
+              rtx pat = PATTERN (prev);
+
+              /* `j $31` is the MIPS `return` pattern `[(return)]`, not a SET.  */
+              if (GET_CODE (pat) == RETURN
+                  || (GET_CODE (pat) == SET
+                      && GET_CODE (SET_SRC (pat)) != IF_THEN_ELSE))
+                {
+                  remove_insn (insn);
+                  emit_insn_before (insn, prev);
+                  emit_insn_after (gen_nop (), prev);
+                }
+              else
+                pad = 0;        /* conditional slot: cannot reorder safely */
+            }
+          if (pad)
+            {
+              emit_insn_before (gen_nop (), insn);
+              emit_insn_before (gen_nop (), insn);
+            }
+        }
+      insn = next;
+    }
+}
