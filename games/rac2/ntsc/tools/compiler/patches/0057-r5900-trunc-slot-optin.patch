diff --git a/gcc/config/mips/mips.md b/gcc/config/mips/mips.md
--- a/gcc/config/mips/mips.md
+++ b/gcc/config/mips/mips.md
@@ -4095,6 +4095,20 @@
    (set (attr "length")	(if_then_else (eq (symbol_ref "mips16") (const_int 0))
 				      (const_int 2)
 				      (const_int 4)))])
+
+;; The stock truncdisi2 prints two machine words from one RTL insn.  On
+;; selected R5900 units, split it after reload so dbr_schedule can put the
+;; final sign-extension in the return delay slot.  The default stays intact.
+(define_split
+  [(set (match_operand:SI 0 "register_operand" "")
+        (truncate:SI (match_operand:DI 1 "se_register_operand" "")))]
+  "TARGET_64BIT && TARGET_MIPS5900
+   && mips_astra_split_trunc_slot && reload_completed
+   && GET_CODE (operands[0]) == REG
+   && GET_CODE (operands[1]) == REG"
+  [(set (match_dup 2) (ashift:DI (match_dup 1) (const_int 32)))
+   (set (match_dup 2) (ashiftrt:DI (match_dup 2) (const_int 32)))]
+  "operands[2] = gen_rtx (REG, DImode, REGNO (operands[0]));")
 
 (define_insn "truncdihi2"
   [(set (match_operand:HI 0 "register_operand" "=d")
