diff --git a/gcc/config/mips/mips.c b/gcc/config/mips/mips.c
--- a/gcc/config/mips/mips.c
+++ b/gcc/config/mips/mips.c
@@ -252,6 +252,8 @@
 char *mips_astra_cygnus_cfg;
 /* Opt-in: expose the two halves of truncdisi2 to delay-slot scheduling.  */
 char *mips_astra_split_trunc_slot;
+/* Opt-in: save every GPR in a TImode slot, as the measured sq/lq units are.  */
+char *mips_astra_quad_saves;
 char *mips_cpu_string;		/* for -mcpu=<xxx> */
 char *mips_isa_string;		/* for -mips{1,2,3,4} */
 char *mips_abi_string;		/* for -mabi={32,n32,64,eabi} */
@@ -4670,6 +4672,13 @@
   if (TARGET_MIPS5900)
     mips_reg_mode[0] = TImode;

+  /* ASTRA 0058 (opt-in): widen every GPR, so the prologue and the epilogue
+     save and restore them in TImode slots (`sq`/`lq`), which is how the
+     retail units that need it are saved. The default stays 8-byte `sd`.  */
+  if (TARGET_MIPS5900 && mips_astra_quad_saves)
+    for (regno = GP_REG_FIRST; regno <= GP_REG_LAST; regno++)
+      mips_reg_mode[regno] = TImode;
+
   /* CYGNUS LOCAL law */
   {
     int min_align = 2;
diff --git a/gcc/config/mips/mips.h b/gcc/config/mips/mips.h
--- a/gcc/config/mips/mips.h
+++ b/gcc/config/mips/mips.h
@@ -608,7 +608,8 @@
 extern char *mips_astra_sibcall;
 /* ASTRA 0049: opt back into the Cygnus sibcall pass's CFG cleanup.  */
 extern char *mips_astra_cygnus_cfg;
 extern char *mips_astra_split_trunc_slot;
+extern char *mips_astra_quad_saves;

 #define TARGET_OPTIONS							\
 {									\
@@ -630,7 +631,8 @@
   { "astra-r5900-extern-buffer", &mips_astra_r5900_extern_buffer },		\
   { "astra-keep-frame-order", &mips_astra_keep_frame_order },		\
   { "astra-annul-dead-slots", &mips_astra_annul_dead_slots },		\
-  { "astra-split-trunc-slot", &mips_astra_split_trunc_slot }		\
+  { "astra-split-trunc-slot", &mips_astra_split_trunc_slot },		\
+  { "astra-quad-saves", &mips_astra_quad_saves }		\
 }

 /* This is meant to be redefined in the host dependent files.  */
