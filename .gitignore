# Your own discs, and everything extracted or built from them, never go into
# git (docs/policy/SOURCING.md). Each game directory has its own .gitignore
# for its build output; these rules cover the shared top level.
/baserom/*
!/baserom/README.md
/build/
/assets/
/active/
# Local Switch builds, verification logs, and editor backups.
/port/build-switch*/
/port/*.log
/port/*.backup
# Disc images and extracted disc files are supplied by each player.
*.[iI][sS][oO]
iso_data/
# Homebrew applications belong in release downloads, not the source tree.
*.[nN][rR][oO]
/toolchains/*
!/toolchains/README.md
# tools/openrac.py setup links each game's toolchain path to toolchains/.
/games/*/*/toolchain
/games/*/toolchain

# Python and editors
__pycache__/
*.pyc
.venv/
venv*/
.DS_Store
Thumbs.db
.vscode/
.idea/

# Agent worktrees and local notes
.claude/worktrees/
.claude/settings.local.json

# What a sync leaves when a hunk does not apply (tools/sources.py): resolve by hand, never commit
*.rej
*.orig

# The copy of OpenRAC an installer carries (tools/bundle_standalone.py), built, not kept.
/launcher/src-tauri/resources/openrac/*
!/launcher/src-tauri/resources/openrac/README.txt
